@model Hassann_Khala.Application.DTOs.Reports.MovementDetailsDto

@if (Model == null || !Model.Groups.Any())
{
    <div class="alert alert-info">لا يوجد بيانات مطابقة </div>
}
else
{
    foreach (var g in Model.Groups)
    {
        <div class="card mb-3">
            <div class="card-body">
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>اسم المنتج</th>
                            <th class="text-end">الوارد (كرتون)</th>
                            <th class="text-end">الوارد (بالتات)</th>
                            <th class="text-end">الصادر (كرتون)</th>
                            <th class="text-end">الصادر (بالتات)</th>
                            <th>التاريخ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var idx = 1; }
                        @foreach (var m in g.Movements)
                        {
                            <tr>
                                <td>@m.ProductName</td>
                                <td class="text-end">
                                    @if (m.MovementType == "Inbound")
                                    {
                                        @m.Cartons.ToString("N0")
                                    }
                                    else
                                    {
                                        <text>-</text>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (m.MovementType == "Inbound")
                                    {
                                        @m.Pallets.ToString("N0")
                                    }
                                    else
                                    {
                                        <text>-</text>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (m.MovementType == "Outbound")
                                    {
                                        @m.Cartons.ToString("N0")
                                    }
                                    else
                                    {
                                        <text>-</text>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (m.MovementType == "Outbound")
                                    {
                                        @m.Pallets.ToString("N0")
                                    }
                                    else
                                    {
                                        <text>-</text>
                                    }
                                </td>
                                <td>@m.Date.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    </tbody>
                    <tbody>
                        <tr>
                            <td>الاجمالي</td>
                            <td class="text-end">
                                @g.TotalIncomingCartons
                            </td>
                            <td class="text-end">
                                @g.TotalIncomingPallets
                            </td>
                            <td class="text-end">
                                @g.TotalOutgoingCartons
                            </td>
                            <td class="text-end">
                                @g.TotalOutgoingPallets
                            </td>
                            <td></td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td>الصافي</td>
                            <td class="text-end">
                                @g.NetCartons
                            </td>
                            <td class="text-end">
                                @g.NetPallets
                            </td>
                            <td class="text-end"></td>
                            <td class="text-end"></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
}
